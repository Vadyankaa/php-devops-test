services:
  php:
    build:
      context: .
      dockerfile: Dockerfile
    restart: unless-stopped
    volumes:
      - home-directory:/var/www/html/home
    networks:
      - app-net

  nginx:
    image: nginx:alpine
    restart: unless-stopped
    ports:
      - "{{ app_port }}:80"
    volumes:
      - ./src:/var/www/html
      - home-directory:/var/www/html/home
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - php
    networks:
      - app-net

networks:
  app-net:
    driver: bridge

volumes:
  home-directory: